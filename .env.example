# Copy to .env for local development. docker compose needs no .env at all:
# it falls back to the same local-only defaults. Change every password before
# any real deployment.

# The app's connection: least-privileged role, subject to row-level security.
DATABASE_URL=postgres://aqar_app:local-dev-app-password@localhost:5433/aqar

# Migrations and seed only: the table owner. Never given to the app.
MIGRATION_DATABASE_URL=postgres://aqar_owner:local-dev-owner-password@localhost:5433/aqar

# Read by docker-compose.yml to create both roles.
DB_OWNER_PASSWORD=local-dev-owner-password
DB_APP_PASSWORD=local-dev-app-password

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
